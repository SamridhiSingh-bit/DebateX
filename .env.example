# ==========================================
# DebateX Full-Stack Environment Variables
# ==========================================

# 1. Database Configuration (PostgreSQL)
DB_PASSWORD=your_postgres_password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/debatex
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# 2. Security & JWT
# Must be at least 256 bits (32 characters) long
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000

# 3. AI Opponent & Judge (OpenAI)
OPENAI_API_KEY=your_openai_api_key
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

# 4. CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# 5. Frontend API URL
VITE_API_URL=http://localhost:8080/api
